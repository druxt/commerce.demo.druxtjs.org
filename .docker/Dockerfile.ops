# The operator console: a second Nuxt app on the same Drupal, built at image
# time since it reads nothing from Drupal to build. Node 20, npm, as the
# storefront's image.

FROM uselagoon/node-20-builder:latest AS manifests
COPY ./operator/ /operator/
COPY ./nuxt/vendor/ /nuxt/vendor/
RUN mkdir /manifests && cd /operator && cp package.json package-lock.json /manifests/

FROM uselagoon/node-20-builder:latest AS deps
COPY --from=manifests /manifests /app/
# The sockets package is vendored beside the storefront; the file: path
# resolves to it from /app the way it does from operator/ in the repository.
COPY --from=manifests /nuxt/vendor /nuxt/vendor
WORKDIR /app
RUN npm ci

FROM uselagoon/node-20-builder:latest AS build
COPY --from=deps /app /app
COPY --from=deps /nuxt/vendor /nuxt/vendor
COPY ./operator/ /app/
WORKDIR /app
RUN NODE_OPTIONS=--openssl-legacy-provider npm run build

FROM uselagoon/node-20:latest
COPY --from=build --chown=10000:0 /app /app
COPY --from=build --chown=10000:0 /nuxt/vendor /nuxt/vendor
WORKDIR /app

ENV HOST=0.0.0.0 PORT=3000 DRUPAL_URL=http://nginx:8080
EXPOSE 3000

CMD ["node", "server/start.js"]
