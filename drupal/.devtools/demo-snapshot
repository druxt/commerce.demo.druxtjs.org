#!/usr/bin/env bash
#
# Keep the fresh store: the database and the files as they are right after
# provisioning, so `.devtools/demo-reset` can put them back in seconds.
#
# Written to the private files directory, which the web server never serves
# and which Lagoon keeps on the shared files volume.
set -euo pipefail

cd "$(dirname "$0")/.."

DRUSH="$PWD/vendor/bin/drush"
# Drupal can exceed PHP's default memory limit; see .devtools/etc/php.ini.
export PHPRC="$PWD/.devtools/etc"
FILES="$PWD/web/sites/default/files"
DIR="${DRUXT_RESET_DIR:-$FILES/private/druxt-reset}"

mkdir -p "$DIR"

echo "==> Snapshot of the database"
DB="${DB_FILE:-/tmp/quickstart-commerce-drupal-site.sqlite}"
# Drupal's own answer, not an environment variable: on Lagoon the database
# URL is set only where the install runs.
DRIVER=$("$DRUSH" php:eval 'echo \Drupal::database()->driver();')
case "$DRIVER" in
  sqlite)
    # The file itself. A dump cannot come back through the sqlite3 tool,
    # which lacks the NOCASE_UTF8 collation Drupal's driver registers.
    "$DRUSH" php:eval '\Drupal::database()->query("PRAGMA wal_checkpoint(TRUNCATE)");' >/dev/null
    cp "$DB" "$DIR/database.sqlite"
    rm -f "$DIR/database.sql"
    ;;
  *)
    # --no-tablespaces: MariaDB refuses the dump without the PROCESS privilege.
    "$DRUSH" sql:dump --result-file="$DIR/database.sql" --extra-dump=--no-tablespaces >/dev/null
    rm -f "$DIR/database.sqlite"
    ;;
esac

echo "==> Snapshot of the files"
# The generated directories come back on their own; the private directory
# holds this snapshot.
tar -C "$FILES" -czf "$DIR/files.tgz" \
  --exclude=./private --exclude=./php --exclude=./css --exclude=./js \
  --exclude=./styles .

date -u +%Y-%m-%dT%H:%M:%SZ > "$DIR/taken"
echo "==> Snapshot in $DIR ($(du -sh "$DIR" | cut -f1))"
