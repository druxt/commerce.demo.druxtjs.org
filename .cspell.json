{
  "files": ["**/*.{js,mjs,cjs,vue,json,jsonc,md,yml,yaml}"],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell-project-words.txt"
    }
  ],
  "dictionaries": ["project-words", "bash", "misc", "node", "softwareTerms"],
  "ignorePaths": [
    ".git/",
    "node_modules/",
    "drupal/web/",
    "drupal/vendor/",
    "coverage/",
    "*.lock",
    "package-lock.json",
    "*.svg",
    "*.png",
    "*.jpg",
    "*.gif",
    "*.ico",
    "*.min.*",
    ".devcontainer/extensions/*/*.vsix"
  ],
  "useGitignore": true,
  "language": "en,en-GB"
}
